# Copy to .env.local and fill in real values. Never commit .env.local.

# Canonical public URL of the site (used for metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (see docs/SUPABASE_SETUP.md) ---
# Project Settings → API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key; only one of the two is needed.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret key. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never
# import into client code, never commit. Not needed by the app yet.
SUPABASE_SERVICE_ROLE_KEY=

# --- Outgoing email (Zoho Mail SMTP) ---
# Used to email the team when a booking request arrives. SERVER-ONLY: never
# prefix with NEXT_PUBLIC_. Leave SMTP_PASSWORD empty to switch sending off
# (requests are still saved in the admin).
# Zoho US accounts: smtp.zoho.com; EU: smtp.zoho.eu. Port 465 (SSL).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
# The Zoho mailbox you sign in with.
SMTP_USER=
# An app-specific password from Zoho (My Account → Security → App Passwords),
# not your normal sign-in password.
SMTP_PASSWORD=
# Sender shown on the email: the mailbox above or one of its aliases.
# EMAIL_FROM="Bound2Zanzibar Website <info@bound2zanzibar.co.tz>"
# Where new booking requests are sent (defaults to booking@bound2zanzibar.co.tz).
# BOOKING_NOTIFY_EMAIL=

# --- Visitor AI assistant ("Ask AI" tab) ---
# SERVER-ONLY Claude API key from https://platform.claude.com (API Keys). Never
# prefix with NEXT_PUBLIC_. Leave empty to keep the assistant switched off: the
# tab then shows your contact details instead. Set a monthly spend limit in the
# Claude Console.
ANTHROPIC_API_KEY=
