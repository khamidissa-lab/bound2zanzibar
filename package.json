{
  "name": "bound-to-zanzibar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test": "vitest run",
    "pretest": "npm run db:seed:generate",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:types": "tsx scripts/db-types.ts",
    "db:photos": "tsx --env-file=.env.local scripts/upload-sample-photos.ts",
    "i18n:ui": "tsx --env-file=.env.local scripts/i18n-ui.ts",
    "i18n:content": "tsx --env-file=.env.local scripts/i18n-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
